APP_ENV=development
APP_NAME=SmartReco
APP_BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./smartreco.db

# Production Supabase PostgreSQL connection string
# DATABASE_URL=postgresql+psycopg://postgres.project:password@host:6543/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Every language-model and embedding call is routed through Mesh. Production
# deployments enable this only after the credentials below are configured.
MESH_API_KEY=
MESH_CALLS_ENABLED=true
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-5.6-luna
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=smartreco-products
PINECONE_NAMESPACE=development

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@smartreco.local
SMTP_USE_TLS=true

SESSION_COOKIE_SECURE=false
RECOMMENDATION_COOLDOWN_MINUTES=15
RECOMMENDATION_TTL_MINUTES=360
RECOMMENDATION_HOURLY_LIMIT=4
RECOMMENDATION_DAILY_LIMIT=12
EVENT_BATCH_MAX_SIZE=50
OUTBOX_MAX_RETRIES=5
SCHEDULER_ENABLED=true
SCHEDULER_METRICS_PORT=9101

# Production Docker/Compose controls (not read by the application itself)
SMARTRECO_IMAGE=smartreco:latest
APP_VERSION=local
SMARTRECO_BIND_ADDRESS=0.0.0.0
SMARTRECO_PORT=8000
WEB_CONCURRENCY=1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-monitoring-password
GRAFANA_ROOT_URL=http://localhost:3000
